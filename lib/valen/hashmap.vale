// A hash map with open addressing and linear probing. Keys need hash and ==. There's no
// removal, which the pathfinder doesn't need.
//
// The entries live densely in insertion order, and the slot table holds each one's index there,
// or -1 for an empty slot. (Valen's backend can't make an interface value like Opt yet, so slots
// can't be Opt<Entry>.)

struct HashMap<K, V> {
  entries List<Entry<K, V>>;
  slots List<int>;
}

struct Entry<K, V> {
  key K;
  value V;
}

func HashMap<K, V>() HashMap<K, V> {
  return HashMap<K, V>(List<Entry<K, V>>(), emptySlots(16));
}

func emptySlots(capacity int) List<int> {
  slots = List<int>();
  i = 0;
  while (i < capacity) {
    slots.add(0 - 1);
    set i = i + 1;
  }
  return ^slots;
}

func len<K, V>(self &HashMap<K, V>) int {
  return self.entries.len();
}

// The slot holding key, or the empty slot where it would go
func slotOf<K, V>(self &HashMap<K, V>, key &K) int
where func hash(&K) int, func ==(&K, &K) bool {
  capacity = self.slots.len();
  i = floorMod(hash(key), capacity);
  while (true) {
    entry = clone(self.slots.get(i));
    if (entry < 0) {
      return i;
    }
    if (self.entries.get(entry).key == key) {
      return i;
    }
    set i = floorMod(i + 1, capacity);
  }
  return 0 - 1;
}

func has<K, V>(self &HashMap<K, V>, key &K) bool
where func hash(&K) int, func ==(&K, &K) bool {
  return not (self.slots.get(self.slotOf(key)) < 0);
}

// The value for key; check has first
func get<K, V>(self &HashMap<K, V>, key &K) &V
where func hash(&K) int, func ==(&K, &K) bool {
  entry = clone(self.slots.get(self.slotOf(key)));
  return &self.entries.get(entry).value;
}

// Adds key, or replaces its value
func put<K, V>(self &HashMap<K, V> mut, key K, value V)
where func hash(&K) int, func ==(&K, &K) bool, func drop(K) void, func drop(V) void {
  i = self.slotOf(&key);
  entry = clone(self.slots.get(i));
  if (entry < 0) {
    self.slots.set(i, self.entries.len());
    self.entries.add(Entry<K, V>(^key, ^value));
    // Keep at most half the slots full, so probes stay short
    if (self.entries.len() * 2 > self.slots.len()) {
      self.grow();
    }
  } else {
    drop(self.entries.set(entry, Entry<K, V>(^key, ^value)));
  }
}

// Doubles the slot table and puts every entry back in it
func grow<K, V>(self &HashMap<K, V> mut)
where func hash(&K) int, func ==(&K, &K) bool {
  drop(set self.slots = emptySlots(self.slots.len() * 2));
  i = 0;
  while (i < self.entries.len()) {
    self.slots.set(self.slotOf(&self.entries.get(i).key), clone(i));
    set i = i + 1;
  }
}

func floorMod(a int, b int) int {
  m = mod(a, b);
  return if (m < 0) { m + b } else { clone(m) };
}
