// The pathfinder's entry points for lib/valenAStar.js. Only numbers and bools cross into Wasm, and
// the path comes back through the externs below one move at a time.
//
// A Search stays in Wasm between ticks, boxed in a one-element array: newSearch returns the box
// into a slot JS allocates, and JS passes that slot back as the box's borrow. (Valen can't yet
// take an owned struct or array back from the host, so endSearch empties the box rather than
// destroying it.)
// exports: newSearch,computeSearch,searchCost,visitedNodes,generatedNodes,reportPath,endSearch

extern func pathMove(x int, y int, z int, remainingBlocks int, cost float, parkour bool);
extern func pathBreak(x int, y int, z int);
extern func pathPlace(
  x int, y int, z int, dx int, dy int, dz int, jump bool, useOne bool,
  hasReturnPos bool, returnX int, returnY int, returnZ int);

exported func newSearch(
  canDig bool, placeCost float, liquidCost float, entityCost float, dontCreateFlow bool,
  dontMineUnderFallingBlock bool, allow1by1towers bool, allowParkour bool, allowSprinting bool,
  allowEntityDetection bool, canOpenDoors bool, maxDropDown float,
  infiniteLiquidDropdownDistance bool, minY int,
  x int, y int, z int, remainingBlocks int, timeout float, tickTimeout float, searchRadius float
) []Search {
  settings = Settings(
    canDig, placeCost, liquidCost, entityCost, dontCreateFlow, dontMineUnderFallingBlock,
    allow1by1towers, allowParkour, allowSprinting, allowEntityDetection, canOpenDoors,
    maxDropDown, infiniteLiquidDropdownDistance, minY);
  box = Array<Search>(1);
  box.push(Search(World(^settings), Move(x, y, z, remainingBlocks, 0.0), timeout, tickTimeout, searchRadius));
  return ^box;
}

// Searches until done or out of time for this tick: 0 success, 1 partial, 2 timeout, 3 noPath
exported func computeSearch(box &[]Search mut) int {
  return box[0].compute();
}

exported func searchCost(box &[]Search) float {
  search = box[0];
  return search.nodes.get(search.result).g;
}

exported func visitedNodes(box &[]Search) int {
  return box[0].closedCount;
}

exported func generatedNodes(box &[]Search) int {
  search = box[0];
  return search.closedCount + search.open.size();
}

// Reports the path to the node the last compute ended on, from the start's first move
exported func reportPath(box &[]Search) {
  search = box[0];
  backwards = List<int>();
  i = search.result;
  while (search.nodes.get(i).parent >= 0) {
    backwards.add(clone(i));
    set i = search.nodes.get(i).parent;
  }
  while (not backwards.isEmpty()) {
    move = &search.nodes.get(backwards.pop()).move;
    pathMove(move.x, move.y, move.z, move.remainingBlocks, move.cost, move.parkour);
    j = 0;
    while (j < move.toBreak.len()) {
      target = move.toBreak.get(j);
      pathBreak(target.x, target.y, target.z);
      set j = j + 1;
    }
    set j = 0;
    while (j < move.toPlace.len()) {
      p = move.toPlace.get(j);
      if (p.returnPos.isEmpty()) {
        pathPlace(p.x, p.y, p.z, p.dx, p.dy, p.dz, p.jump, p.useOne, false, 0, 0, 0);
      } else {
        r = p.returnPos.get();
        pathPlace(p.x, p.y, p.z, p.dx, p.dy, p.dz, p.jump, p.useOne, true, r.x, r.y, r.z);
      }
      set j = j + 1;
    }
  }
  drop(^backwards);
}

exported func endSearch(box &[]Search mut) {
  drop(box.pop());
}

// valec only builds programs; lib/valenAStar.js never calls this
exported func main() int {
  return 0;
}
