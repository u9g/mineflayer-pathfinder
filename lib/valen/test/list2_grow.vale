// List<int> growing past its capacity; main returns 0, or the number of the failed check.
// uses: list.vale

struct P {
  a int;
  b float;
}

exported func main() int {
  l = List<int>();
  i = 0;
  while (i < 100) {
    l.add(clone(i));
    set i = i + 1;
  }
  if (l.get(57) != 57) { return 1; }
  return 0;
}
