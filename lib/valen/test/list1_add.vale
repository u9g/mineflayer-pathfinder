// List<int> add and get; main returns 0, or the number of the failed check.
// uses: prelude.vale list.vale

struct P {
  a int;
  b float;
}

exported func main() int {
  l = List<int>();
  l.add(1);
  l.add(2);
  l.add(3);
  if (l.get(1) != 2) { return 1; }
  if (l.len() != 3) { return 2; }
  return 0;
}
