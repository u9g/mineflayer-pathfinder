// Can JS hold a Valen object between calls? Variant C: a HashMap field, exported down to its arrays. handle_b.js drives it.
// exports: newSearch,step,total
// uses: list.vale hashmap.vale

exported struct Counter {
  count int;
  history List<int>;
  seen HashMap<Pos, int>;
}

exported struct Search {
  counter Counter;
}

exported func newSearch(start int) Search {
  return Search(Counter(start, List<int>(), HashMap<Pos, int>()));
}

exported func step(self &Search mut) int {
  set self.counter.count = self.counter.count + 1;
  self.counter.history.add(clone(self.counter.count));
  self.counter.seen.put(Pos(self.counter.count, 0, 0), clone(self.counter.count));
  return self.counter.history.len();
}

exported func total(self &Search) int {
  return self.counter.count;
}

exported func main() int {
  return 0;
}

export List<int> as IntList;
export []int as IntArray;
export HashMap<Pos, int> as PosIndex;
export List<Opt<Entry<Pos, int>>> as PosIndexSlots;
export []Opt<Entry<Pos, int>> as PosIndexSlotArray;
export Opt<Entry<Pos, int>> as PosIndexSlot;
export Some<Entry<Pos, int>> as PosIndexFull;
export None<Entry<Pos, int>> as PosIndexEmpty;
export Entry<Pos, int> as PosIndexEntry;

exported struct Pos {
  x int;
  y int;
  z int;
}

func hash(self &Pos) int {
  return (self.x * 31 + self.y) * 31 + self.z;
}

func ==(a &Pos, b &Pos) bool {
  return a.x == b.x and a.y == b.y and a.z == b.z;
}
