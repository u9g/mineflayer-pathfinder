// a generic struct holding an array, used only from main, borrow checker on; main returns 0, or the number of the failed check.
// uses: none
// borrow-check: true

struct Box<T> {
  array []T;
}

exported func main() int {
  b = Box<int>(Array<int>(4));
  b.array.push(7);
  if (b.array.len() != 1) { return 1; }
  return 0;
}
