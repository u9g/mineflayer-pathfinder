// a non-generic struct holding an array, borrow checker on; main returns 0, or the number of the failed check.
// uses: none
// borrow-check: true

struct IntList {
  array []int;
}

func add(self &IntList mut, x int) {
  self.array.push(x);
}

func get(self &IntList, i int) int {
  return self.array[clone(i)];
}

exported func main() int {
  l = IntList(Array<int>(4));
  l.add(7);
  l.add(9);
  if (l.get(1) != 9) { return 1; }
  return 0;
}
