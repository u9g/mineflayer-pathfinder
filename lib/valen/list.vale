// A growable list that owns its elements. Valen's stdlib List grows with migrate, which isn't
// implemented yet, so this one moves its elements into a bigger array by hand.

struct List<T> {
  array []T;
}

func List<T>() List<T> {
  return List<T>(Array<T>(8));
}

func len<T>(self &List<T>) int {
  return self.array.len();
}

func isEmpty<T>(self &List<T>) bool {
  return self.array.len() == 0;
}

func add<T>(self &List<T> mut, element T) {
  if (self.array.len() == self.array.capacity()) {
    self.grow();
  }
  self.array.push(^element);
}

func get<T>(self &List<T>, index int) &T {
  return self.array[clone(index)];
}

// Replaces the element at index, returning the old one
func set<T>(self &List<T> mut, index int, element T) T {
  return set self.array[clone(index)] = ^element;
}

func pop<T>(self &List<T> mut) T {
  return self.array.pop();
}

func grow<T>(self &List<T> mut) {
  old = set self.array = Array<T>(self.array.capacity() * 2);
  // Popping reverses the order, so go through a second array to restore it
  reversed = Array<T>(old.len());
  while (old.len() > 0) {
    reversed.push(old.pop());
  }
  while (reversed.len() > 0) {
    self.array.push(reversed.pop());
  }
  [] = ^old;
  [] = ^reversed;
}

// Moves every element of other onto the end of this list, in order
func addAll<T>(self &List<T> mut, other List<T>) {
  reversed = reversed(^other);
  while (not reversed.isEmpty()) {
    self.add(reversed.pop());
  }
  [array] = ^reversed;
  [] = ^array;
}

// The same elements in the opposite order, so popping them goes from first to last
func reversed<T>(list List<T>) List<T> {
  result = List<T>();
  while (not list.isEmpty()) {
    result.add(list.pop());
  }
  [array] = ^list;
  [] = ^array;
  return ^result;
}
